#!/usr/bin/env bash
set -euo pipefail

plugin_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

"$plugin_root/scripts/check-ci"

for qml_file in "$plugin_root"/*.qml "$plugin_root"/components/*.qml; do
  qmllint -I /usr/share/omarchy/shell -I "$plugin_root" "$qml_file"
done

omarchy plugin validate "$plugin_root"
echo "omarchy-taskwarrior checks passed"
